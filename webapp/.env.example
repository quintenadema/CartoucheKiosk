# Neon Postgres (gebruik bij voorkeur de pooled connection string)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=genereer-met-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
ADMIN_EMAILS=beheerder@example.com
ADMIN_LOGIN_EMAIL=beheerder@example.com

# Wordt automatisch toegevoegd wanneer een Vercel Blob-store is gekoppeld
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Alleen tijdelijk gebruiken door scripts/create-admin.mjs; nooit op Vercel aanzetten
ALLOW_ADMIN_SIGNUP=false
